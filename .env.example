# CrimsonPanel Configuration (Port 8090)
PORT=8090
JWT_SECRET=super-secret-key-change-this-in-production-vps-7890123
JWT_EXPIRES_IN=7d

# Storage & Database
STORAGE_DIR=./storage
DATA_DIR=./storage/data
APPS_DIR=./storage/apps
DB_PATH=./storage/data/crimson.db

# Executable Binaries
PYTHON_BIN=python3
NODE_BIN=node
NPM_BIN=npm

# CORS Configuration
CORS_ORIGIN=*

# Daemon Settings
MAX_LOG_LINES=1000
AUTO_START_ON_BOOT=true
